package algotrade;

public class Investor {
    private final UserAccount userAccount;
    private final Portfolio portfolio;
    private double availableCash;

    public Investor(UserAccount userAccount, double startingCash) {
        if (userAccount == null) {
            throw new IllegalArgumentException("User account cannot be empty.");
        }
        if (startingCash < 0) {
            throw new IllegalArgumentException(
                    "Starting cash cannot be negative.");
        }

        this.userAccount = userAccount;
        this.portfolio = new Portfolio();
        this.availableCash = startingCash;
    }

    public String getUsername() {
        return userAccount.getUsername();
    }

    public Portfolio getPortfolio() {
        return portfolio;
    }

    public double getAvailableCash() {
        return availableCash;
    }

    public boolean canAfford(double amount) {
        return amount > 0 && availableCash >= amount;
    }

    public void deductCash(double amount) {
        if (amount <= 0) {
            throw new IllegalArgumentException(
                    "Amount must be greater than zero.");
        }
        if (amount > availableCash) {
            throw new IllegalArgumentException(
                    "There is not enough cash for this purchase.");
        }

        availableCash -= amount;
    }

    public void addCash(double amount) {
        if (amount <= 0) {
            throw new IllegalArgumentException(
                    "Amount must be greater than zero.");
        }

        availableCash += amount;
    }
}